[node name="Dicas" type="Label" parent="Centro/Painel/Margem/Coluna"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.9, 1)
text = "A horta fica na frente de casa: are com a enxada, plante, regue e durma na cama para as plantas crescerem.
A vendinha fica na rua da frente: o balcão vende sementes e comida, e o baú ao lado compra o que você deixar nele.
Os inimigos ficam cercados no pátio industrial, ao norte. Eles voltam um tempo depois de cair."
autowrap_mode = 3

[node name="BotaoComecar" type="Button" parent="Centro/Painel/Margem/Coluna"]
