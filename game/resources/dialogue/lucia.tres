[sub_resource type="Resource" id="Resource_a115u"]
script = ExtResource("1_dwx7p")
id = "lucia_1adc15d3"
falante_id = "lucia"
texto = "Bom dia. Lúcia Prado, do programa de expansão. Não vim incomodar, vim conhecer."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_ffddq"]
script = ExtResource("1_dwx7p")
id = "lucia_3257efef"
falante_id = "lucia"
texto = "Veja, eu entendo a desconfiança. Mas a cidade tem hospital a vinte minutos daqui. A vila tem a Iara."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_bw5bv"]
script = ExtResource("1_dwx7p")
id = "lucia_d62da5b9"
falante_id = "lucia"
texto = "Os números mostram que uma fazenda nessa terra fecha no vermelho em dois anos. Mas os números já erraram antes."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_qy8hf"]
script = ExtResource("1_dwx7p")
id = "lucia_e1d060d5"
falante_id = "lucia"
texto = "Eu venho toda semana, no mesmo ônibus. Pode me procurar se tiver dúvida sobre o programa."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_iycjf"]
script = ExtResource("1_dwx7p")
id = "lucia_d03b99f6"
falante_id = "lucia"
texto = "Com todo respeito, essa bomba solar não aguenta mais uma Estiagem. A cidade aguenta."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_s6dnj"]
script = ExtResource("1_dwx7p")
id = "lucia_e8aef980"
falante_id = "lucia"
texto = "Eu não sou daqui, mas sou de um lugar igual. Por isso me mandam pra cá. Dizem que eu falo a língua."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_v6nm4"]
script = ExtResource("1_dwx7p")
id = "lucia_e494af9e"
falante_id = "lucia"
texto = "Na cidade ninguém almoça na praça. Aqui eu almoço. Não conta no relatório."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_3j5i3"]
script = ExtResource("1_dwx7p")
id = "lucia_a674a506"
falante_id = "lucia"
texto = "A Marta me olha como se eu fosse a seca em pessoa. Eu respeito. Ela tá defendendo o que é dela."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_b5js4"]
script = ExtResource("1_dwx7p")
id = "lucia_9e408ffc"
falante_id = "lucia"
texto = "A adesão ao programa nesta vila é de zero por cento. É o pior indicador da fronteira. Eu acho isso, sinceramente, admirável."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_ilsjc"]
script = ExtResource("1_dwx7p")
id = "lucia_4b81263e"
falante_id = "lucia"
texto = "A sua fazenda é o único indicador que sobe por aqui. Isso me deixa curiosa. E preocupada, um pouco."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_bamuk"]
script = ExtResource("1_dwx7p")
id = "lucia_8438bb30"
falante_id = "lucia"
texto = "Minha mãe morreu de uma infecção que o hospital da cidade curava em dois dias. A vila dela não tinha hospital. É por isso que eu faço o que faço."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_inq0g"]
script = ExtResource("1_dwx7p")
id = "lucia_33ac8f33"
falante_id = "lucia"
texto = "Eu trago no bolso um saquinho de semente de tomate da minha mãe. Nunca plantei. Não sei onde."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_xvtja"]
script = ExtResource("1_dwx7p")
id = "lucia_f1f6d95c"
falante_id = "lucia"
texto = "A Sol trabalhou comigo. Era a melhor. Eu não vou dizer mais nada sobre isso."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_8qkgu"]
script = ExtResource("1_dwx7p")
id = "lucia_f5af662f"
falante_id = "lucia"
texto = "Às vezes eu desço do ônibus e fico um minuto parada no ponto. Só respirando. Na cidade o ar é filtrado."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_vt23e"]
script = ExtResource("1_dwx7p")
id = "lucia_f25ec3ea"
falante_id = "lucia"
texto = "Eu sabia para onde a Sol tinha ido. Nunca escrevi no relatório. Ela não sabe disso."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_c5xhb"]
script = ExtResource("1_dwx7p")
id = "lucia_3801343b"
falante_id = "lucia"
texto = "Eu não sei mais o que estou entregando quando a cidade chega. Antes eu sabia. Antes eu tinha certeza."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_bgcxe"]
script = ExtResource("1_dwx7p")
id = "lucia_0acb28aa"
falante_id = "lucia"
texto = "Se eu sair do programa, mandam alguém que não almoça na praça. É por isso que eu fico. É o que eu digo pra mim."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_888tu"]
