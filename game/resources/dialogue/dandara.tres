id = "dandara_03e51359"
falante_id = "dandara"
texto = "O Vitor é o único que mexe em moto tão bem quanto eu. Não conta pra ele que eu disse."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_w1xen"]
