id = "dandara_86603216"
falante_id = "dandara"
texto = "Cedinho é a melhor hora da estrada. O asfalto ainda tá frio e a cidade ainda tá dormindo."
situacoes = Array[StringName]([&"manha"])

[sub_resource type="Resource" id="Resource_xwvbs"]
script = ExtResource("1_txd6p")
id = "dandara_9171fbbf"
falante_id = "dandara"
texto = "Folga. As meninas dormem e eu desmonto moto que não precisa. Não sei ficar parada."
situacoes = Array[StringName]([&"folga"])

[sub_resource type="Resource" id="Resource_ndh2f"]
