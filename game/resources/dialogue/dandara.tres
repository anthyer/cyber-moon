id = "dandara_fb9b8c0a"
falante_id = "dandara"
texto = "Tem uma estrada que sobe até a Torre deles. Eu conheço. Não te levo. Ainda."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_n41yf"]
script = ExtResource("1_txd6p")
id = "dandara_643b393e"
falante_id = "dandara"
texto = "Minha vila foi a primeira que a expansão engoliu. Minha família aceitou o crédito e foi morar num bloco. Eu peguei a moto do meu pai e não fui."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_yilq3"]
script = ExtResource("1_txd6p")
id = "dandara_a9bcdc5c"
falante_id = "dandara"
texto = "Toda noite eu conserto a moto de uma das meninas. Escondido. Elas acham que a moto é que é boa."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_texon"]
script = ExtResource("1_txd6p")
id = "dandara_f618323a"
falante_id = "dandara"
texto = "Eu falo de liberdade o tempo todo. E sou a que mais tem gente pra cuidar. Engraçado, né."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_kpcwi"]
