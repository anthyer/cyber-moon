[sub_resource type="Resource" id="Resource_nqehg"]
script = ExtResource("1_txd6p")
id = "dandara_50062a9a"
falante_id = "dandara"
texto = "Ô, lavoura. Dandara. Pode chamar de Dada. Precisa de alguma coisa da estrada? Fala agora que eu saio às seis."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_x4px0"]
script = ExtResource("1_txd6p")
id = "dandara_6e9862dd"
falante_id = "dandara"
texto = "Essa fazenda tava abandonada faz tempo. Bom ver luz lá. A gente usa de referência na pista."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_kmi4q"]
script = ExtResource("1_txd6p")
id = "dandara_7c70b3ad"
falante_id = "dandara"
texto = "Não encosta na moto. Pode olhar. Olhar é de graça."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_kipbx"]
script = ExtResource("1_txd6p")
id = "dandara_39f0ad6b"
falante_id = "dandara"
texto = "Se tiver biocombustível sobrando, eu compro. Se não tiver, faz."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_srw20"]
script = ExtResource("1_txd6p")
id = "dandara_1d4ca7b6"
falante_id = "dandara"
texto = "Patrulha nova no trecho do viaduto. Se for pra lá, vai pela pista de baixo."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_q3ufq"]
script = ExtResource("1_txd6p")
id = "dandara_c71fdffd"
falante_id = "dandara"
texto = "Levo os repetidores do Kenji pras outras vilas. Ele monta, eu entrego. Ele fala, eu ando."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_pjasv"]
script = ExtResource("1_txd6p")
id = "dandara_79ae61cc"
falante_id = "dandara"
texto = "As meninas do acampamento vieram cada uma de um lugar. Nenhuma quis ir pra cidade. Bora, que é isso que a gente tem em comum."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_b8bo1"]
