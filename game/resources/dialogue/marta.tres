id = "marta_6539d138"
falante_id = "marta"
texto = "Marta. Se precisar de alguma coisa, peça. Se não precisar, não fique parado na frente da prateleira."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_lhr65"]
