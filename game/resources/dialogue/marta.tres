[gd_resource type="Resource" script_class="Conversa" format=3]

[ext_resource type="Script" path="res://scripts/resources/no_dialogo.gd" id="1_cj2x5"]
[ext_resource type="Script" path="res://scripts/resources/conversa.gd" id="2_8wt1t"]

[sub_resource type="Resource" id="Resource_2vldx"]
script = ExtResource("1_cj2x5")
id = "marta_01"
falante_id = "marta"
texto = "Bom dia. Semente tá na prateleira do fundo, e o preço tá na plaquinha."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_ieu18"]
script = ExtResource("1_cj2x5")
id = "marta_02"
falante_id = "marta"
texto = "Você é o da fazenda do morro. Já sei. Aqui todo mundo sabe tudo."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_wcn80"]
script = ExtResource("1_cj2x5")
id = "marta_03"
falante_id = "marta"
texto = "Primeira safra é sempre ruim. Não desanima com isso."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_3ijlg"]
script = ExtResource("1_cj2x5")
id = "marta_04"
falante_id = "marta"
texto = "Compra semente de estação. Fora de estação não nasce, e você vai vir reclamar comigo."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_hvkmy"]
script = ExtResource("1_cj2x5")
id = "marta_05"
falante_id = "marta"
texto = "Sua cenoura tá melhor que a do ano passado. E eu vendi a semente dos dois anos."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_lhr65"]
script = ExtResource("1_cj2x5")
id = "marta_06"
falante_id = "marta"
texto = "Tem gente que compra semente e não compra regador. Aí planta e chora."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_iijoh"]
script = ExtResource("1_cj2x5")
id = "marta_07"
falante_id = "marta"
texto = "Meu marido plantava. Trinta e dois anos. Depois virou isso aqui tudo estacionamento."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_lqw0j"]
script = ExtResource("1_cj2x5")
id = "marta_08"
falante_id = "marta"
texto = "Você come direito? Não parece."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_7ecjp"]
script = ExtResource("1_cj2x5")
id = "marta_09"
falante_id = "marta"
texto = "Eu abro essa loja há vinte e seis anos e nunca fechei um dia. Nem no enterro dele."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_8skp0"]
script = ExtResource("1_cj2x5")
id = "marta_10"
falante_id = "marta"
texto = "O Kenji vem aqui comprar comida pronta e acha que eu não vejo que ele não cozinha."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_8dc2w"]
script = ExtResource("1_cj2x5")
id = "marta_11"
falante_id = "marta"
texto = "Guarda semente da sua própria colheita. Não conta pro fornecedor que eu falei isso."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_vh64i"]
script = ExtResource("1_cj2x5")
id = "marta_12"
falante_id = "marta"
texto = "Se um dia faltar dinheiro, você leva e paga depois. Uma vez só. Não abuse."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_6h6op"]
script = ExtResource("1_cj2x5")
id = "marta_13"
falante_id = "marta"
texto = "Você virou parte do lugar. Isso não acontece com todo mundo que chega."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_rdqea"]
script = ExtResource("1_cj2x5")
id = "marta_14"
falante_id = "marta"
texto = "Quando eu não puder mais abrir, alguém abre. Talvez você. Pensa nisso sem pressa."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_13phv"]
script = ExtResource("1_cj2x5")
id = "marta_15"
falante_id = "marta"
texto = "Sabe o que me faz continuar? Ver saco de semente saindo daqui e voltando como comida."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_6s0fj"]
script = ExtResource("1_cj2x5")
id = "marta_16"
falante_id = "marta"
texto = "Época boa de venda. Todo mundo acha que esse ano vai ser diferente."
estacoes = Array[StringName]([&"brotacao"])

[sub_resource type="Resource" id="Resource_yputu"]
script = ExtResource("1_cj2x5")
id = "marta_17"
falante_id = "marta"
texto = "Se não regar, não colhe. E não adianta vir reclamar da semente."
estacoes = Array[StringName]([&"estiagem"])

[sub_resource type="Resource" id="Resource_bgqn5"]
script = ExtResource("1_cj2x5")
id = "marta_18"
falante_id = "marta"
texto = "Agora eu compro mais do que vendo. Traga tudo."
estacoes = Array[StringName]([&"colheita"])

[sub_resource type="Resource" id="Resource_h8qd3"]
script = ExtResource("1_cj2x5")
id = "marta_19"
falante_id = "marta"
texto = "Nada nasce. Guarde comida e paciência."
estacoes = Array[StringName]([&"apagao"])

