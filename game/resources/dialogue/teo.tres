[sub_resource type="Resource" id="Resource_mcnas"]
script = ExtResource("1_oger6")
id = "teo_46b92e03"
falante_id = "teo"
texto = "Você é da fazenda nova? Eu sou o Téo. Eu sei tudo daqui. Tudo mesmo."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_yve3d"]
script = ExtResource("1_oger6")
id = "teo_159263ca"
falante_id = "teo"
texto = "Sabia que embaixo do rio tem um monstro de mil metros? É verdade. Ninguém acredita."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_ff5nd"]
script = ExtResource("1_oger6")
id = "teo_80b06053"
falante_id = "teo"
texto = "O Kenji é meu tio. Ele cuida da antena. Eu cuido do resto."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_7sw1x"]
script = ExtResource("1_oger6")
id = "teo_e80641ff"
falante_id = "teo"
texto = "Se você achar osso grande no deserto, é meu, tá? Eu vi primeiro. De longe, mas vi."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_su6lj"]
