[sub_resource type="Resource" id="Resource_mcnas"]
script = ExtResource("1_oger6")
id = "teo_5fef03d6"
falante_id = "teo"
texto = "Você é da fazenda nova? Tem bicho? Tem trator? Tem osso?"
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_yve3d"]
script = ExtResource("1_oger6")
id = "teo_9b7d4bd8"
falante_id = "teo"
texto = "Sabia que tem um osso no campo maior que eu? Juro. Eu medi deitado."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_ff5nd"]
script = ExtResource("1_oger6")
id = "teo_b100e1e6"
falante_id = "teo"
texto = "Eu sou o Téo. Sobrinho do tio Kenji. Ele é o da antena. Ele subiu sozinho. Duas vezes."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_7sw1x"]
script = ExtResource("1_oger6")
id = "teo_50dfabaa"
falante_id = "teo"
texto = "O Bento disse que lá dentro da Galeria tem um robô que varre gente. Varre mesmo."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_su6lj"]
script = ExtResource("1_oger6")
id = "teo_568c9fa8"
falante_id = "teo"
texto = "Minha mochila tem catorze tesouros. Não pode ver. Pode ver um."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_tedcg"]
script = ExtResource("1_oger6")
id = "teo_55fa03ae"
falante_id = "teo"
texto = "Achei uma placa queimada perto do viaduto. É de nave espacial. Juro. Bom, o tio disse que não, mas ele não viu."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_qkq2d"]
script = ExtResource("1_oger6")
id = "teo_4313d8eb"
falante_id = "teo"
texto = "A Dandara disse que quando eu crescer eu posso andar de moto. Ela disse \"vamos ver\", que é sim."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_u3l3p"]
script = ExtResource("1_oger6")
id = "teo_0e565f4c"
falante_id = "teo"
texto = "O Hélio sabe o nome de toda planta. Até das feias. Principalmente das feias."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_6mg45"]
script = ExtResource("1_oger6")
id = "teo_fdb3ef80"
falante_id = "teo"
texto = "O tio Kenji esquece de jantar. Aí eu esqueço também. Aí a Marta lembra os dois."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_ryl0k"]
script = ExtResource("1_oger6")
id = "teo_e61db363"
falante_id = "teo"
texto = "Se você achar osso, me dá? Eu troco por pedra. Tenho pedra boa."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_kh0y0"]
script = ExtResource("1_oger6")
id = "teo_59db4210"
falante_id = "teo"
texto = "Não tem escola aqui. O tio me ensina conta com rádio. Eu sei somar frequência."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_g1bs3"]
script = ExtResource("1_oger6")
id = "teo_2ddc0efb"
falante_id = "teo"
texto = "Eu durmo com a lanterna acesa. Não é medo. É pra achar osso de noite se precisar."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_geyqu"]
script = ExtResource("1_oger6")
id = "teo_b24313a0"
falante_id = "teo"
texto = "A Dandara me deixou sentar na moto. Parada. Mas valeu."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_5smlv"]
script = ExtResource("1_oger6")
id = "teo_34d68ee1"
falante_id = "teo"
texto = "Quando eu crescer eu vou entrar na Galeria e trazer o robô pra casa. Pra ele varrer o meu quarto."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_d8ohb"]
script = ExtResource("1_oger6")
id = "teo_0333053e"
falante_id = "teo"
texto = "Minha mãe vem na Folga. Às vezes. Você acha que ela vem nessa?"
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_gcp44"]
script = ExtResource("1_oger6")
id = "teo_44154a56"
falante_id = "teo"
texto = "Eu guardo a passagem de ônibus que ela deixou. Um dia eu vou atrás dela. Não conta pro tio."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_oqqhs"]
script = ExtResource("1_oger6")
id = "teo_c738532c"
falante_id = "teo"
texto = "O tio Kenji acha que tá fazendo tudo errado comigo. Ele não tá. Fala pra ele. Pra mim ele não acredita."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_5e20x"]
script = ExtResource("1_oger6")
id = "teo_54a1a0d4"
falante_id = "teo"
texto = "Brotação tem bicho saindo de tudo que é buraco. E meu aniversário!"
estacoes = Array[StringName]([&"brotacao"])

[sub_resource type="Resource" id="Resource_afuwt"]
script = ExtResource("1_oger6")
id = "teo_97f14234"
falante_id = "teo"
texto = "Na Estiagem o vento descobre osso novo. É a melhor estação pra caçar."
estacoes = Array[StringName]([&"estiagem"])

[sub_resource type="Resource" id="Resource_ie3wc"]
script = ExtResource("1_oger6")
id = "teo_60221ca1"
falante_id = "teo"
texto = "Na Colheita a Marta dá milho escondido. Não conta que eu contei."
estacoes = Array[StringName]([&"colheita"])

[sub_resource type="Resource" id="Resource_c1nsu"]
script = ExtResource("1_oger6")
id = "teo_6404b7d3"
falante_id = "teo"
texto = "No Apagão fica escuro de dia. Eu não tenho medo. Eu só ando mais perto do tio."
estacoes = Array[StringName]([&"apagao"])

[sub_resource type="Resource" id="Resource_f0sib"]
script = ExtResource("1_oger6")
id = "teo_fd9b8ebf"
falante_id = "teo"
texto = "Oi! Você é da fazenda nova? Eu vi o caminhão da mudança! Bom, não vi, mas imaginei."
