id = "teo_0dc7a2f2"
falante_id = "teo"
texto = "O tio não dorme. Quando ele cai em cima da bancada, eu cubro ele com o lençol. Não conta pra ele."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_5smlv"]
