id = "teo_96ad31d0"
falante_id = "teo"
texto = "Às vezes a minha mãe liga e cai no meio. O tio fala que é a antena. Eu acho que é a cidade."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_oqqhs"]
