[sub_resource type="Resource" id="Resource_sja1j"]
script = ExtResource("1_oger6")
id = "teo_fa54bba9"
falante_id = "teo"
texto = "Você sumiu! Eu procurei você no mapa inteiro. Bom, em metade."
situacoes = Array[StringName]([&"sumido"])

[sub_resource type="Resource" id="Resource_8ed20"]
script = ExtResource("1_oger6")
id = "teo_3f82b4ce"
falante_id = "teo"
texto = "Você se machucou? Você vai morrer? Vai na Iara. Cuidado que ela dá vacina."
situacoes = Array[StringName]([&"vida_baixa"])

[sub_resource type="Resource" id="Resource_5mrgd"]
script = ExtResource("1_oger6")
id = "teo_5559e2c5"
falante_id = "teo"
texto = "Você entrou lá! Tinha robô que varre gente? Ele varreu você? Conta tudo!"
situacoes = Array[StringName]([&"saiu_da_dungeon"])

[sub_resource type="Resource" id="Resource_iwlxh"]
script = ExtResource("1_oger6")
id = "teo_c6251e78"
falante_id = "teo"
texto = "Chuva! Tem poça no mapa inteiro! Eu já pulei em todas. Faltou uma."
situacoes = Array[StringName]([&"chuva"])

[sub_resource type="Resource" id="Resource_j2qcs"]
script = ExtResource("1_oger6")
id = "teo_1e9c425f"
falante_id = "teo"
texto = "Ontem eu e o tio contamos raio. Ele contou quarenta. Eu contei quarenta e um. Eu ganhei."
situacoes = Array[StringName]([&"tempestade_ontem"])

[sub_resource type="Resource" id="Resource_tcjgn"]
script = ExtResource("1_oger6")
id = "teo_35c13dd9"
falante_id = "teo"
texto = "Hoje é Folga. Eu vou esperar no ponto de ônibus. Minha mãe pode vir."
situacoes = Array[StringName]([&"folga"])

[sub_resource type="Resource" id="Resource_x0qbh"]
script = ExtResource("1_oger6")
id = "teo_7ccd97e3"
falante_id = "teo"
texto = "Shhh. O Bento tá contando a do cano que cantava. É a melhor."
situacoes = Array[StringName]([&"em:porta_da_galeria"])

[sub_resource type="Resource" id="Resource_n3xvb"]
script = ExtResource("1_oger6")
id = "teo_415e5927"
falante_id = "teo"
texto = "Daqui dá pra ver o campo de ossos inteiro. Eu já achei sete lá. Oito, se contar o pequeno."
situacoes = Array[StringName]([&"em:mirante"])

[sub_resource type="Resource" id="Resource_o2rra"]
script = ExtResource("1_oger6")
id = "teo_b00a9dea"
falante_id = "teo"
texto = "O tio deixa eu ficar na antena até as nove. Eu escuto o rádio das outras vilas. Tem uma que só toca música."
situacoes = Array[StringName]([&"noite", &"em:torre_antena"])

[sub_resource type="Resource" id="Resource_hs0iv"]
script = ExtResource("1_oger6")
id = "teo_021516ff"
falante_id = "teo"
texto = "Hoje é meu aniversário! Eu fiz dez. Bom, onze. Não, dez. Dez!"
situacoes = Array[StringName]([&"aniversario"])

[sub_resource type="Resource" id="Resource_3rdkw"]
script = ExtResource("1_oger6")
id = "teo_7e58c139"
falante_id = "teo"
texto = "Hoje é aniversário do tio! Ele esqueceu. Eu não. Eu fiz um cartão de papelão com antena."
situacoes = Array[StringName]([&"aniversario_de:kenji"])

[sub_resource type="Resource" id="Resource_t6hwt"]
script = ExtResource("1_oger6")
id = "teo_f53dc88f"
falante_id = "teo"
texto = "Hoje o Bento faz anos! Eu dei pra ele um osso. O melhor. Quer dizer, o segundo melhor."
situacoes = Array[StringName]([&"aniversario_de:bento"])

[sub_resource type="Resource" id="Resource_dwsux"]
script = ExtResource("1_oger6")
id = "teo_eb71c7bc"
falante_id = "teo"
texto = "Todo mundo tá falando da sua fazenda. Eu falei que fui o primeiro a saber. Fui o segundo, mas o Bento não conta."
situacoes = Array[StringName]([&"marco_1"])
uma_vez = true

