id = "teo_492c1e58"
falante_id = "teo"
texto = "Quer ver minha coleção? Tem quarenta e três ossos. Quarenta e quatro, se contar um que pode ser pedra."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_g1bs3"]
