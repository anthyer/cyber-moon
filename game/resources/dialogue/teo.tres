id = "teo_58515865"
falante_id = "teo"
texto = "Eu anoto tudo num caderno. Você tá nele. Na parte das pessoas boas."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_gcp44"]
