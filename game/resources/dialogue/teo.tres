id = "teo_38aad403"
falante_id = "teo"
texto = "Perdi meu dente de lobo perto da cisterna. Se você achar, é meu. Eu te conto onde tem pedra que brilha."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_qkq2d"]
script = ExtResource("1_oger6")
id = "teo_77781981"
falante_id = "teo"
texto = "O caminhão do Zeca aparece toda semana do nada. É um caminhão fantasma. Eu já vi ele sem ninguém dentro."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_u3l3p"]
script = ExtResource("1_oger6")
id = "teo_ed7c3c7c"
falante_id = "teo"
texto = "O tio diz que é interferência de frequência alta. Eu não sei o que é, mas é perigoso."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_6mg45"]
script = ExtResource("1_oger6")
id = "teo_30d5161d"
falante_id = "teo"
texto = "Eu sei onde os robôs passam de noite. Se você me ajudar a achar meu parafuso, eu te mostro."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_ryl0k"]
