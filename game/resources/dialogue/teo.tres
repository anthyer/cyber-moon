id = "teo_43c7d29c"
falante_id = "teo"
texto = "O Bento disse que na Galeria mora uma máquina que come o barulho. Por isso lá embaixo é tão quieto."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_geyqu"]
