id = "teo_ef1b8a37"
falante_id = "teo"
texto = "A Dandara não me dá garupa nunca. Mas me ensinou a trocar pneu. Agora eu sei trocar pneu de qualquer coisa."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_kh0y0"]
