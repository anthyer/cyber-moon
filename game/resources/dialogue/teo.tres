id = "teo_b8b7e916"
falante_id = "teo"
texto = "A minha mãe trabalha na cidade. Ela falou que eu ia ficar aqui só até as coisas melhorarem."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_d8ohb"]
