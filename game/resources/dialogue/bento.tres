id = "bento_26c3185b"
falante_id = "bento"
texto = "Isso me lembra uma vez que uma bomba lá embaixo engoliu a minha marmita. Inteira. Com a colher."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_4dpan"]
