[sub_resource type="Resource" id="Resource_jkkyc"]
script = ExtResource("1_vt8sv")
id = "bento_e8b64447"
falante_id = "bento"
texto = "Ô, criatura! Fazenda nova, é? Chegou gente na fronteira. A água tá atrasada, mas o vizinho chegou na hora."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_5343p"]
script = ExtResource("1_vt8sv")
id = "bento_3ddf0ac4"
falante_id = "bento"
texto = "Bento. Bento Arruda. Trinta e um anos de Galeria e nenhum de juízo. Pode rir."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_7x1rl"]
script = ExtResource("1_vt8sv")
id = "bento_426c701c"
falante_id = "bento"
texto = "Tá vendo aquela porta? Eu abri e fechei ela onze mil vezes. Contei. Não tinha o que fazer."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_vygoc"]
