[ext_resource type="Script" path="res://scripts/resources/conversa.gd" id="2_e0cag"]

[sub_resource type="Resource" id="Resource_ou3hd"]
script = ExtResource("1_38c5c")
id = "iara_01"
falante_id = "iara"
texto = "Bom dia. Se estiver machucado, entra. Se não, também entra, mas espera."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_8h8rv"]
script = ExtResource("1_38c5c")
id = "iara_02"
falante_id = "iara"
texto = "Você é novo aqui. Aparece pra um exame antes de precisar."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_d13ld"]
script = ExtResource("1_38c5c")
id = "iara_03"
falante_id = "iara"
texto = "Bebe água. É o conselho médico mais ignorado do mundo."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_yk6kv"]
script = ExtResource("1_38c5c")
id = "iara_04"
falante_id = "iara"
texto = "Não tenho anestésico essa semana. Tenta não se cortar."
relacionamento_maximo = 749

[sub_resource type="Resource" id="Resource_yxjtv"]
script = ExtResource("1_38c5c")
id = "iara_05"
falante_id = "iara"
texto = "Atendi doze pessoas hoje. Três pagaram. É uma média boa."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_7arcg"]
script = ExtResource("1_38c5c")
id = "iara_06"
falante_id = "iara"
texto = "Suas mãos estão calejadas. Isso é bom sinal, quer dizer que você usa elas."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_ctwku"]
script = ExtResource("1_38c5c")
id = "iara_07"
falante_id = "iara"
texto = "O Vitor conserta o gerador daqui de graça e finge que foi de passagem."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_kswt4"]
script = ExtResource("1_38c5c")
id = "iara_08"
falante_id = "iara"
texto = "Você dorme quanto por noite? Não responde. Já sei pela sua cara."
relacionamento_minimo = 750
relacionamento_maximo = 1499

[sub_resource type="Resource" id="Resource_u41ah"]
script = ExtResource("1_38c5c")
id = "iara_09"
falante_id = "iara"
texto = "Estudei na cidade. Voltei porque lá eu tratava executivo e aqui eu trato gente."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_y3w8e"]
script = ExtResource("1_38c5c")
id = "iara_10"
falante_id = "iara"
texto = "Perdi um paciente mês passado. Chegou tarde demais. Eu ainda penso nisso todo dia."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_vgnhh"]
script = ExtResource("1_38c5c")
id = "iara_11"
falante_id = "iara"
texto = "Trouxe beterraba? Você lembrou. É a única coisa que eu consigo comer quando tô cansada."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_xlntx"]
script = ExtResource("1_38c5c")
id = "iara_12"
falante_id = "iara"
texto = "Quando você aparece aqui sem estar machucado, o meu dia melhora."
relacionamento_minimo = 1500
relacionamento_maximo = 2499

[sub_resource type="Resource" id="Resource_jqxal"]
script = ExtResource("1_38c5c")
id = "iara_13"
falante_id = "iara"
texto = "Eu cuido de todo mundo. Você é a única pessoa que pergunta como eu estou."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_7kupv"]
script = ExtResource("1_38c5c")
id = "iara_14"
falante_id = "iara"
texto = "Tem uma janela na clínica que dá pra sua fazenda. Eu olho mais do que devia."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_7ac8b"]
script = ExtResource("1_38c5c")
id = "iara_15"
falante_id = "iara"
texto = "Se eu pudesse escolher um lugar pra cansar, era esse. Perto de você."
relacionamento_minimo = 2500

[sub_resource type="Resource" id="Resource_ntoo8"]
script = ExtResource("1_38c5c")
id = "iara_16"
falante_id = "iara"
texto = "Época de alergia. Metade da vila passa aqui espirrando."
estacoes = Array[StringName]([&"brotacao"])

[sub_resource type="Resource" id="Resource_yuqw0"]
script = ExtResource("1_38c5c")
id = "iara_17"
falante_id = "iara"
texto = "Insolação, desidratação, queimadura. Todo ano igual."
estacoes = Array[StringName]([&"estiagem"])

[sub_resource type="Resource" id="Resource_ioix8"]
script = ExtResource("1_38c5c")
id = "iara_18"
falante_id = "iara"
texto = "Todo mundo se machuca colhendo com pressa. Vai devagar, por favor."
estacoes = Array[StringName]([&"colheita"])

[sub_resource type="Resource" id="Resource_sikiv"]
script = ExtResource("1_38c5c")
id = "iara_19"
falante_id = "iara"
texto = "Frio e pouca comida. É a estação que mais me dá trabalho."
estacoes = Array[StringName]([&"apagao"])

